# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
myvenv/
env/
ENV/

# ---------------------------------------------------------------------------
# Downloaded Kaggle corpus (8.6k JPEGs). Never committed to Git -- the dataset
# is reproduced either by `defectvision acquire --source kaggle` or from the
# DVC remote. See docs/DATA.md.
# ---------------------------------------------------------------------------
/datasets/

# ---------------------------------------------------------------------------
# Testing / linting caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------------------------------------------------------------------------
# Data & models -- tracked by DVC, not by Git.
# DVC pointer files (*.dvc, dvc.lock) ARE committed.
# ---------------------------------------------------------------------------
/data/raw/
/data/interim/
/data/processed/
/data/drifted/
/models/
!/data/**/.gitkeep
!/models/.gitkeep

# ---------------------------------------------------------------------------
# MLflow tracking store & runtime artifacts
# ---------------------------------------------------------------------------
/mlruns/
/mlartifacts/
mlflow.db

# ---------------------------------------------------------------------------
# Monitoring: prediction log + drift baseline.
#
# reference_stats.json is a DVC stage output (it carries 4000 reference samples
# per feature), so DVC manages it and Git must not. Regenerate it with
# `defectvision reference-stats`.
# ---------------------------------------------------------------------------
/monitoring/*.db
/monitoring/*.db-journal
/monitoring/*.db-wal
/monitoring/*.db-shm
/monitoring/reference_stats.json
/monitoring/retrain_state.json

# ---------------------------------------------------------------------------
# Generated reports.
#
# The Markdown reports (model_comparison.md, drift_report.md) ARE committed --
# they are graded deliverables. The machine-readable dumps and the ~3 MB
# prediction-log export are regenerated by the pipeline and stay out of Git.
# ---------------------------------------------------------------------------
/reports/figures/
/reports/*.json
/reports/*.jsonl
/reports/*.html

# ---------------------------------------------------------------------------
# DVC internals
# ---------------------------------------------------------------------------
/.dvc/cache/
/.dvc/tmp/
/.dvc/config.local

# ---------------------------------------------------------------------------
# Secrets / local overrides
# ---------------------------------------------------------------------------
.env
*.local.yaml
kaggle.json

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
