# Keep the build context small: everything below is either rebuilt inside the
# image, mounted at run time, or irrelevant to serving.

.git/
.github/
.dvc/cache/
.dvc/tmp/

.venv/
myvenv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Datasets and experiment stores are never baked into the image.
datasets/
data/
mlruns/
mlartifacts/
mlflow.db
monitoring/*.db

# Candidate models are not shipped; only models/production is mounted.
models/candidates/

reports/
notebooks/
docs/
tests/

*.md
!README.md
